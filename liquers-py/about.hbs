<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>liquers-py: third-party notices</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f6f6f6; padding: 1em; }
li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party notices</h1>
<p>liquers-py is licensed under AGPL-3.0-or-later. Its compiled extension includes the Rust crates
listed below, each under the license shown. The full text of each license follows the list.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
