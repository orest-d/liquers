"""Type declarations for ``liquers.data_nodes``; the classes it exports report ``liquers.data_nodes`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

__all__ = [
    "data_node",
    "DataNode",
    "NodeKind",
]

@final
class NodeKind:
    Null: ClassVar[NodeKind]
    Bool: ClassVar[NodeKind]
    Integer: ClassVar[NodeKind]
    Float: ClassVar[NodeKind]
    Text: ClassVar[NodeKind]
    List: ClassVar[NodeKind]
    Map: ClassVar[NodeKind]
    Opaque: ClassVar[NodeKind]
    def __repr__(self) -> str: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __int__(self) -> int: ...

@final
class DataNode:
    @property
    def kind(self) -> NodeKind: ...
    @property
    def scalar(self) -> None | bool | int | float | str: ...
    def __getitem__(self, key: str | int, /) -> DataNode: ...
    def get(self, key: str | int, default: Any = None) -> Any: ...
    def keys(self) -> list[str]: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Any: ...
    def __bool__(self) -> bool: ...
    def to_json(self) -> Any: ...
    def get_async(self, key: str | int) -> Awaitable[DataNode | None]: ...
    def scalar_async(self) -> Awaitable[None | bool | int | float | str]: ...
    def len_async(self) -> Awaitable[int]: ...
    def to_json_async(self) -> Awaitable[Any]: ...
    def __repr__(self) -> str: ...

def data_node(x: Any) -> DataNode: ...
