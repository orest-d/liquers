"""Type declarations for ``liquers.environment``; the classes it exports report ``liquers.environment`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.accessors import Accessor
from liquers.assets import AssetRef, State
from liquers.commands import ArgumentInfo, CommandMetadata, command, first_command
from liquers.data_nodes import DataNode, data_node
from liquers.lui import UI, ui
from liquers.pipeline import Pipeline, PipelineEditor, QueryEditor
from liquers.query import Key, Query
from liquers.recipes import RecipeProviders
from liquers.server import Server, serve, serve_async
from liquers.store import Store, StoreArgumentInfo
from liquers.template import Diagnostic

__all__ = [
    "Environment",
    "Context",
    "Issue",
    "default_environment",
    "evaluate",
    "evaluate_async",
    "require",
]

_P = ParamSpec("_P")
_R = TypeVar("_R")

class _Decorator(Protocol):
    """What ``@command(...)`` with options returns: a decorator keeping the function's signature."""
    def __call__(self, fn: Callable[_P, _R], /) -> Callable[_P, _R]: ...

@final
class Environment:
    def __new__(cls, *, config: os.PathLike[str] | dict[str, Any] | str | None = ..., conversion: Literal["permissive", "strict"] | None = ..., pickle: bool | None = ..., async_loops: int | None = ..., job_capacity: int | None = ...) -> Self: ...
    def evaluate(self, query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Any: ...
    def evaluate_state(self, query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> State: ...
    def get_asset(self, query: Query | str) -> AssetRef: ...
    def store_set(self, key: str, data: Any) -> None: ...
    def evaluate_async(self, query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Awaitable[Any]: ...
    def evaluate_state_async(self, query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Awaitable[State]: ...
    def get_asset_async(self, query: Query | str) -> Awaitable[AssetRef]: ...
    def accessor(self, query: Query | str) -> Accessor: ...
    def accessor_async(self, query: Query | str) -> Awaitable[Accessor]: ...
    def memory_accessor(self, value: Any = ..., address: Query | str | None = ...) -> Accessor: ...
    def store_set_async(self, key: str, data: Any) -> Awaitable[None]: ...
    def data_node(self, x: Any) -> DataNode: ...
    def render(self, template: Query | Key | str, state: Any = ..., data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Any: ...
    def expand(self, template: Query | Key | str, data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Any: ...
    def render_async(self, template: Query | Key | str, state: Any = ..., data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Awaitable[Any]: ...
    def expand_async(self, template: Query | Key | str, data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Awaitable[Any]: ...
    def validate_template(self, text: str) -> list[Diagnostic]: ...
    def template_command(self, name: str, template: Query | Key | str, *, namespace: str = ..., label: str | None = ..., doc: str | None = ..., filename: str | None = ...) -> None: ...
    def pipeline_command(self, name: str, body: Pipeline | list[Any] | dict[str, Any], *, arguments: list[str | ArgumentInfo] = ..., namespace: str = ..., label: str | None = ..., doc: str | None = ..., filename: str | None = ...) -> None: ...
    def pipeline_editor(self, pipeline: Pipeline | list[Any] | dict[str, Any] | None = ...) -> PipelineEditor: ...
    def query_editor(self, query: Query | str | None = ...) -> QueryEditor: ...
    @overload
    def command(self, fn: Callable[_P, _R], /) -> Callable[_P, _R]: ...
    @overload
    def command(self, fn: None = None, *, name: str | None = None, namespace: str = "", label: str | None = None,
                doc: str | None = None, filename: str | None = None, volatile: bool | None = None,
                cached: bool | None = None) -> _Decorator: ...
    @overload
    def first_command(self, fn: Callable[_P, _R], /) -> Callable[_P, _R]: ...
    @overload
    def first_command(self, fn: None = None, *, name: str | None = None, namespace: str = "", label: str | None = None,
                      doc: str | None = None, filename: str | None = None, volatile: bool | None = None,
                      cached: bool | None = None) -> _Decorator: ...
    def _register_command(self, callable: Callable[..., Any], baseline: dict[str, Any], declaration: dict[str, Any],
                          context_index: int | None, implementation: bytes | None) -> tuple[str, list[str]]: ...
    def unregister(self, name: str, namespace: str = ...) -> bool: ...
    def command_metadata(self, name: str, namespace: str = ...) -> CommandMetadata: ...
    def import_metadata(self, yaml: str) -> None: ...
    def validate(self) -> list[Issue]: ...
    def register_store_factory(self, type: str, factory: Callable[..., Any], *, label: str = ..., doc: str = ..., arguments: Sequence[StoreArgumentInfo] | None = ...) -> None: ...
    def register_recipe_provider_factory(self, type: str, factory: Callable[..., Any], *, label: str = ..., doc: str = ..., arguments: Sequence[StoreArgumentInfo] | None = ...) -> None: ...
    def store_types(self) -> list[dict[str, Any]]: ...
    def serve(self, *, host: str | None = ..., port: int | None = ..., prefix: str | None = ...,
              apis: Sequence[Literal["query", "store", "assets", "recipes"]] | None = ..., read_only: bool | None = ...,
              web: bool | str | None = ..., background: bool = ...) -> Server: ...
    def serve_async(self, *, host: str | None = ..., port: int | None = ..., prefix: str | None = ...,
                    apis: Sequence[Literal["query", "store", "assets", "recipes"]] | None = ..., read_only: bool | None = ...,
                    web: bool | str | None = ...) -> Coroutine[Any, Any, None]: ...
    @property
    def servers(self) -> list[Server]: ...
    def ui(self) -> UI: ...
    def shutdown(self) -> None: ...
    @property
    def liquers_version(self) -> str: ...
    @property
    def recipes(self) -> RecipeProviders: ...
    @property
    def store(self) -> Store: ...

@final
class Issue:
    def __repr__(self) -> str: ...
    @property
    def severity(self) -> str: ...
    @property
    def key(self) -> str | None: ...
    @property
    def message(self) -> str: ...

@final
class Context:
    def evaluate(self, query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Any: ...
    def evaluate_async(self, query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Awaitable[Any]: ...
    def data_node(self, x: Any) -> DataNode: ...
    def render(self, template: Query | Key | str, state: Any = ..., data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Any: ...
    def expand(self, template: Query | Key | str, data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Any: ...
    def render_async(self, template: Query | Key | str, state: Any = ..., data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Awaitable[Any]: ...
    def expand_async(self, template: Query | Key | str, data: Any = ..., *, errors: str = ..., cwd: Key | None = ..., html: bool = ..., full: bool = ...) -> Awaitable[Any]: ...
    def validate_template(self, text: str) -> list[Diagnostic]: ...
    def info(self, message: str) -> None: ...
    def warning(self, message: str) -> None: ...
    def error(self, message: str) -> None: ...
    def is_cancelled(self) -> bool: ...
    @property
    def element(self) -> int | None: ...

def default_environment() -> Environment: ...

def evaluate(query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Any: ...

def evaluate_async(query: Query | str | Pipeline | list[Any] | tuple[Any, ...] | dict[str, Any]) -> Awaitable[Any]: ...

def require(extra: str) -> None: ...
