"""Type declarations for ``liquers.commands``; the classes it exports report ``liquers.commands`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.environment import Environment
from liquers.pipeline import Pipeline

__all__ = [
    "command",
    "first_command",
    "CommandMetadata",
    "CommandDefinition",
    "CommandKey",
    "CommandPreset",
    "CommandMetadataRegistry",
    "ArgumentInfo",
    "ArgumentType",
    "EnumArgument",
    "EnumArgumentType",
]

_P = ParamSpec("_P")
_R = TypeVar("_R")

class _Decorator(Protocol):
    """What ``@command(...)`` with options returns: a decorator keeping the function's signature."""
    def __call__(self, fn: Callable[_P, _R], /) -> Callable[_P, _R]: ...

