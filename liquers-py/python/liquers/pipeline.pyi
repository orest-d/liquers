"""Type declarations for ``liquers.pipeline``; the classes it exports report ``liquers.pipeline`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.commands import ArgumentInfo, CommandMetadata
from liquers.environment import Environment
from liquers.query import Query, link

__all__ = [
    "Pipeline",
    "PipelineEditor",
    "QueryEditor",
    "ActionEditor",
]

@final
class Pipeline:
    def __new__(cls, data: list[Any] | tuple[Any, ...] | dict[str, Any] | Pipeline) -> Self: ...
    @staticmethod
    def from_query(query: Query | str) -> Pipeline: ...
    @staticmethod
    def from_json(text: str) -> Pipeline: ...
    def to_json(self) -> str: ...
    def to_list(self) -> list[Any] | dict[str, Any]: ...
    def to_query(self, env: Environment) -> Query: ...
    @property
    def elements_count(self) -> int: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __repr__(self) -> str: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]

@final
class PipelineEditor:
    def push(self, element: str | dict[str, Any]) -> Self: ...
    def insert(self, at: int, element: str | dict[str, Any]) -> Self: ...
    def replace(self, at: int, element: str | dict[str, Any]) -> Self: ...
    def remove(self, at: int) -> Self: ...
    def move_to(self, from_: int, to: int) -> Self: ...
    def set_realm(self, realm: str) -> Self: ...
    def set_filename(self, name: str | None) -> Self: ...
    def resource(self, key: str, read: str = ...) -> Self: ...
    def default_ns(self, ns: str | list[str] | None) -> Self: ...
    def action(self, name: str, ns: str | list[str] | None = ...) -> ActionEditor: ...
    def edit_action(self, at: int) -> ActionEditor: ...
    def command_metadata(self, at: int) -> CommandMetadata: ...
    def argument_info(self, at: int, arg: str | int) -> ArgumentInfo: ...
    def unset_arguments(self, at: int) -> list[ArgumentInfo]: ...
    def validate(self) -> None: ...
    @property
    def pipeline(self) -> Pipeline: ...

