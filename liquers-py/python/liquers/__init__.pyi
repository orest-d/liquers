class _Decorator(Protocol):
    """What ``@command(...)`` with options returns: a decorator keeping the function's signature."""
    def __call__(self, fn: Callable[_P, _R], /) -> Callable[_P, _R]: ...

_Fields: TypeAlias = dict[str, FieldType | str | FieldSchema] | RecordSchema | None
_MetadataLike: TypeAlias = Metadata | MetadataRecord | dict[str, Any]

