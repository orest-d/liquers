"""Type declarations for ``liquers.accessors``; the classes it exports report ``liquers.accessors`` as their module."""

from collections.abc import AsyncIterator, Callable, Coroutine
from typing import Any, Literal, final

from typing_extensions import Self

from liquers.assets import State
from liquers.commands import ArgumentInfo, CommandKey
from liquers.metadata import LogEntry, Status
from liquers.query import Query

__all__ = [
    "Accessor",
    "AccessorCapabilities",
    "AccessorSnapshot",
    "AccessorInfo",
    "AccessorEvent",
    "PartDescription",
    "AccessorSubscription",
]


@final
class Accessor:
    @property
    def address(self) -> Query: ...
    @property
    def capabilities(self) -> AccessorCapabilities: ...
    def get(self) -> Any: ...
    def snapshot(self) -> AccessorSnapshot: ...
    def set(self, value: Any) -> str: ...
    def set_if(self, value: Any, token: str | None) -> str: ...
    def info(self) -> AccessorInfo: ...
    def log(self, since: int = ...) -> list[LogEntry]: ...
    def describe(self) -> PartDescription: ...
    def refresh(self) -> None: ...
    def project(self, actions: str) -> Accessor: ...
    def on(self, callback: Callable[[AccessorEvent], object]) -> AccessorSubscription: ...
    def process_events(self) -> int: ...
    def wait_event(self, timeout: float | None = ...) -> AccessorEvent | None: ...
    def get_async(self) -> Coroutine[Any, Any, Any]: ...
    def snapshot_async(self) -> Coroutine[Any, Any, AccessorSnapshot]: ...
    def set_async(self, value: Any) -> Coroutine[Any, Any, str]: ...
    def set_if_async(self, value: Any, token: str | None) -> Coroutine[Any, Any, str]: ...
    def info_async(self) -> Coroutine[Any, Any, AccessorInfo]: ...
    def refresh_async(self) -> Coroutine[Any, Any, None]: ...
    def project_async(self, actions: str) -> Coroutine[Any, Any, Accessor]: ...
    def wait_event_async(self, timeout: float | None = ...) -> Coroutine[Any, Any, AccessorEvent | None]: ...
    def events(self) -> AsyncIterator[AccessorEvent]: ...
    def __repr__(self) -> str: ...

@final
class AccessorCapabilities:
    def __repr__(self) -> str: ...
    @property
    def write(self) -> bool: ...
    @property
    def notify(self) -> bool: ...

@final
class AccessorSnapshot:
    @property
    def value(self) -> Any: ...
    @property
    def state(self) -> State: ...
    @property
    def token(self) -> str: ...
    @property
    def root_version(self) -> str: ...
    def __repr__(self) -> str: ...

@final
class AccessorInfo:
    def __repr__(self) -> str: ...
    @property
    def status(self) -> Status: ...
    @property
    def message(self) -> str: ...
    @property
    def primary_progress(self) -> dict[str, Any] | None: ...
    @property
    def secondary_progress(self) -> dict[str, Any] | None: ...
    @property
    def log_len(self) -> int: ...
    @property
    def token(self) -> str | None: ...

@final
class AccessorEvent:
    def __repr__(self) -> str: ...
    @property
    def kind(self) -> Literal["initial", "status", "progress", "log", "changed", "invalidated", "removed"]: ...
    @property
    def status(self) -> Status | None: ...
    @property
    def primary(self) -> dict[str, Any] | None: ...
    @property
    def secondary(self) -> dict[str, Any] | None: ...
    @property
    def count(self) -> int | None: ...
    @property
    def token(self) -> str | None: ...

@final
class PartDescription:
    def __repr__(self) -> str: ...
    @property
    def step(self) -> str: ...
    @property
    def type_identifier(self) -> str: ...
    @property
    def argument(self) -> ArgumentInfo | None: ...
    @property
    def command(self) -> CommandKey | None: ...
    @property
    def overridden(self) -> bool: ...
    @property
    def read_only(self) -> bool: ...

@final
class AccessorSubscription:
    def dispose(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_exc: object) -> bool: ...
