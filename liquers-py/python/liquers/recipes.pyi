"""Type declarations for ``liquers.recipes``; the classes it exports report ``liquers.recipes`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.metadata import Expires
from liquers.pipeline import Pipeline
from liquers.plan import Plan
from liquers.query import Key, ResourceName

__all__ = [
    "Recipe",
    "RecipeList",
    "RecipeProviders",
]

@final
class Recipe:
    def __new__(cls, query: str, title: str = ..., description: str = ..., *, cwd: str | None = ..., volatile: bool = ..., expires: Expires | None = ...) -> Self: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> Recipe: ...
    def to_yaml(self) -> str: ...
    @staticmethod
    def from_yaml(yaml: str) -> Recipe: ...
    @property
    def volatile(self) -> bool: ...
    @volatile.setter
    def volatile(self, value: bool) -> None: ...
    @property
    def title(self) -> str: ...
    @title.setter
    def title(self, value: str) -> None: ...
    @property
    def description(self) -> str: ...
    @description.setter
    def description(self, value: str) -> None: ...
    @property
    def cwd(self) -> str | None: ...
    @cwd.setter
    def cwd(self, value: str | None) -> None: ...
    @property
    def expires(self) -> Expires: ...
    @expires.setter
    def expires(self, value: Expires) -> None: ...
    @property
    def links(self) -> dict[str, Any]: ...
    @property
    def pipeline(self) -> Pipeline | None: ...
    @property
    def arguments(self) -> dict[str, Any]: ...
    @property
    def query(self) -> str: ...
    @query.setter
    def query(self, value: str) -> None: ...

@final
class RecipeList:
    def __new__(cls) -> Self: ...
    def __len__(self) -> int: ...
    def add_recipe(self, recipe: Recipe) -> None: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(json: str) -> RecipeList: ...

@final
class RecipeProviders:
    def recipe_opt(self, key: Key | str) -> Recipe | None: ...
    def recipe_opt_async(self, key: Key | str) -> Awaitable[Recipe | None]: ...
    def recipe(self, key: Key | str) -> Recipe: ...
    def recipe_async(self, key: Key | str) -> Awaitable[Recipe]: ...
    def recipe_plan(self, key: Key | str) -> Plan: ...
    def recipe_plan_async(self, key: Key | str) -> Awaitable[Plan]: ...
    def assets_with_recipes(self, folder: Key | str) -> list[ResourceName]: ...
    def assets_with_recipes_async(self, folder: Key | str) -> Awaitable[list[ResourceName]]: ...
    def contains(self, key: Key | str) -> bool: ...
    def contains_async(self, key: Key | str) -> Awaitable[bool]: ...
    def can_make(self, key: Key | str) -> bool: ...
    def can_make_async(self, key: Key | str) -> Awaitable[bool]: ...
