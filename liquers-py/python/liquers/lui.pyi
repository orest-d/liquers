"""Type declarations for ``liquers.lui``; the classes it exports report ``liquers.lui`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.assets import AssetRef
from liquers.error import LiquersError
from liquers.metadata import Status
from liquers.query import Query

__all__ = [
    "ui",
    "UI",
    "UIElement",
    "UIElementInfo",
    "UIStatusEvent",
    "UISubscription",
]

@final
class UI:
    def show(self, query: Query | str, handle: int | None = ...) -> int: ...
    def submit(self, query: Query | str, handle: int | None = ...) -> None: ...
    def elements(self) -> list[UIElementInfo]: ...
    def on(self, kind: Literal["status"], callback: Callable[[UIStatusEvent], object]) -> UISubscription: ...
    def wait_idle(self, timeout: float | None = ...) -> bool: ...
    def wait_idle_async(self, timeout: float | None = ...) -> Coroutine[Any, Any, bool]: ...
    def process_events(self) -> int: ...
    def asset(self, handle: int) -> AssetRef: ...
    def run(self, title: str = ..., size: tuple[float, float] = ...) -> None: ...
    def close(self) -> None: ...
    @property
    def window_open(self) -> bool: ...
    def dispose(self) -> None: ...
    @property
    def disposed(self) -> bool: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_exc: object) -> bool: ...
    def __repr__(self) -> str: ...

@final
class UIElementInfo:
    def __repr__(self) -> str: ...
    @property
    def handle(self) -> int: ...
    @property
    def parent(self) -> int | None: ...
    @property
    def type_name(self) -> str | None: ...
    @property
    def title(self) -> str | None: ...
    @property
    def status(self) -> Status: ...

@final
class UIStatusEvent:
    def __repr__(self) -> str: ...
    @property
    def handle(self) -> int | None: ...
    @property
    def status(self) -> Status: ...
    @property
    def error(self) -> LiquersError | None: ...

@final
class UISubscription:
    def dispose(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_exc: object) -> bool: ...

@final
class UIElement:
    def __repr__(self) -> str: ...
    @property
    def type_name(self) -> str: ...
    @property
    def title(self) -> str: ...

def ui() -> UI: ...
