"""Type declarations for ``liquers.dependencies``; the classes it exports report ``liquers.dependencies`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.metadata import Version

__all__ = [
    "DependencyKey",
    "DependencyRecord",
    "DependencyRelation",
    "PlanDependency",
]

@final
class DependencyKey:
    def __new__(cls, value: str) -> Self: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    def encode(self) -> str: ...

@final
class DependencyRecord:
    def __new__(cls, key: DependencyKey, version: Version) -> Self: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    @property
    def version(self) -> Version: ...
    @property
    def key(self) -> DependencyKey: ...

@final
class DependencyRelation:
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __str__(self) -> str: ...
    def __lt__(self, value: Self, /) -> bool: ...
    def __le__(self, value: Self, /) -> bool: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __gt__(self, value: Self, /) -> bool: ...
    def __ge__(self, value: Self, /) -> bool: ...
    @staticmethod
    def state_argument() -> DependencyRelation: ...
    @staticmethod
    def parameter_link(name: str) -> DependencyRelation: ...
    @staticmethod
    def default_link(name: str) -> DependencyRelation: ...
    @staticmethod
    def recipe_link(name: str) -> DependencyRelation: ...
    @staticmethod
    def override_link(name: str) -> DependencyRelation: ...
    @staticmethod
    def enum_link(name: str) -> DependencyRelation: ...
    @staticmethod
    def context_evaluate(query: str) -> DependencyRelation: ...
    @staticmethod
    def command_metadata() -> DependencyRelation: ...
    @staticmethod
    def command_implementation() -> DependencyRelation: ...
    @staticmethod
    def recipe() -> DependencyRelation: ...
    def encode(self) -> str: ...

@final
class PlanDependency:
    def __new__(cls, key: DependencyKey, relation: DependencyRelation) -> Self: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __str__(self) -> str: ...
    def __lt__(self, value: Self, /) -> bool: ...
    def __le__(self, value: Self, /) -> bool: ...
    def __eq__(self, value: object, /) -> bool: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __gt__(self, value: Self, /) -> bool: ...
    def __ge__(self, value: Self, /) -> bool: ...
    @property
    def relation(self) -> DependencyRelation: ...
    @property
    def key(self) -> DependencyKey: ...
