"""Type declarations for ``liquers.assets``; the classes it exports report ``liquers.assets`` as their module."""

import os
from collections.abc import Awaitable, Callable, Coroutine, Iterable, Mapping, Sequence
from typing import Any, ClassVar, Literal, Protocol, TypeVar, final, overload

from typing_extensions import ParamSpec, Self, TypeAlias

from liquers.data_nodes import DataNode, data_node
from liquers.metadata import Metadata, Status
from liquers.records import RecordView

__all__ = [
    "State",
    "AssetRef",
]

@final
class State:
    def __repr__(self) -> str: ...
    def record_view(self) -> RecordView | None: ...
    def data_node(self) -> DataNode: ...
    @property
    def metadata(self) -> Metadata: ...
    @property
    def value(self) -> Any: ...

@final
class AssetRef:
    def __repr__(self) -> str: ...
    def get(self) -> Any: ...
    def get_state(self) -> State: ...
    def cancel(self) -> None: ...
    def get_async(self) -> Awaitable[Any]: ...
    def get_state_async(self) -> Awaitable[State]: ...
    def cancel_async(self) -> Awaitable[None]: ...
    @property
    def status(self) -> Status: ...
    @property
    def metadata(self) -> Metadata: ...
