# Generated by Cargo
# will have compiled files and executables
debug/
target/

venv/   

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb
*.ipynb
liquers-axum/xxx/*

# packaged skill bundles are generated from .claude/skills/
*.skill
__pycache__/
*.pyc
specs/index.html

# `maturin develop` copies the built extension into the mixed-layout package
liquers-py/python/liquers/_native*.so
liquers-py/python/liquers/_native*.pyd
liquers-py/python/liquers/THIRD-PARTY-NOTICES.html
